---
title: Happiness streaming - dimensional model (MySQL)
---
%% =====================================================================
%% GRAIN
%%   fact_predictions      : one row per UNIQUE EVENT (event_id) that was validated and predicted
%%                           = one prediction of the happiness score of one country in one year.
%%   dim_country           : one row per country.
%%   dim_date              : one row per observation year (the source reports are annual).
%%   raw_happiness_events  : one row per Kafka message (topic + partition + offset) stored exactly
%%                           as it arrived, valid or not. Staging table, NOT a dimension.
%%   duplicate_events      : one row per Kafka message whose event_id was already predicted.
%%                           Audit table, NOT part of the star.
%% STAR SCHEMA = fact_predictions + dim_country + dim_date
%% =====================================================================
erDiagram
    dim_country ||--o{ fact_predictions : "country_id"
    dim_date ||--o{ fact_predictions : "date_id"
    raw_happiness_events ||--o| fact_predictions : "raw_event_id"
    raw_happiness_events ||--o{ duplicate_events : "original_raw_event_id"

    dim_country {
        int country_id PK "surrogate key"
        varchar country_name UK "150"
        varchar region "nullable"
    }

    dim_date {
        int date_id PK "observation year, e.g. 2019"
        int year
        varchar decade "e.g. 2010s"
    }

    fact_predictions {
        bigint prediction_id PK
        varchar event_id UK "degenerate dimension, blocks duplicates"
        int raw_event_id FK, UK "traceability to the original message"
        int country_id FK
        int date_id FK
        double gdp "model input"
        double family "model input"
        double health "model input"
        double freedom "model input"
        double generosity "model input"
        double corruption "model input"
        double actual_score "measure"
        double predicted_score "measure"
        double prediction_error "measure, predicted - actual"
        datetime event_time "emitted by the producer"
        datetime prediction_timestamp "generated by the consumer"
    }

    raw_happiness_events {
        int raw_event_id PK
        varchar event_id "nullable, read from the JSON"
        varchar kafka_topic UK
        int kafka_partition UK
        bigint kafka_offset UK
        varchar kafka_key
        mediumtext raw_payload "message exactly as it arrived"
        datetime received_at
        varchar processing_status "RECEIVED, VALID, INVALID_SCHEMA, INVALID_VALUES, PREDICTION_ERROR"
        text status_detail
        datetime processed_at
    }

    duplicate_events {
        int duplicate_event_id PK
        varchar event_id
        int original_raw_event_id FK
        varchar kafka_topic UK
        int kafka_partition UK
        bigint kafka_offset UK
        varchar kafka_key
        mediumtext raw_payload "duplicate exactly as it arrived"
        datetime received_at
    }
